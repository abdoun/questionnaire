# Symfony application
# Use APP_ENV=dev for local development.
APP_ENV=prod
APP_SECRET=replace-with-a-random-secret
MAILER_DSN=null://null

# Local database connection (Docker Compose builds DATABASE_URL from the
# MYSQL_* values below instead).
DATABASE_URL="mysql://questionnaire:replace-with-a-database-password@127.0.0.1:3306/questionnaire?serverVersion=8.4&charset=utf8mb4"

# Docker Compose
APP_BIND_IP=127.0.0.1
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_DATABASE=questionnaire
MYSQL_USER=questionnaire
MYSQL_PASSWORD=replace-with-a-database-password
