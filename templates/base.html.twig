<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="">
  <meta name="author" content="">

  <title>{{ title}}</title>
  <link rel="icon" href="{{asset('icons8-questionnaire-32.png')}}" type="image/gif" sizes="16x16">
  <!-- Bootstrap core CSS -->
  <link href="{{asset('vendor/bootstrap/css/bootstrap.min.css')}}" rel="stylesheet">
  <link rel="stylesheet" href="{{asset('font-awesome/css/font-awesome.min.css')}}">
  <!-- Custom styles for this template -->
  <link href="{{asset('css/small-business.css')}}" rel="stylesheet">

</head>

<body>

  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="{{path('homepage')}}">Questionnaire</a>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarResponsive">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item {% if app.request.get('_route')=='homepage' %}active{% endif %}">
            <a class="nav-link" href="{{path('homepage')}}">Home
                {% if app.request.get('_route')=='homepage' %}
                    <span class="sr-only">(current)</span>
                {% endif %}
            </a>
          </li>
          <li class="nav-item {% if app.request.get('_route')=='about' %}active{% endif %}">
            <a class="nav-link" href="{{path('about')}}">About
                {% if app.request.get('_route')=='about' %}
                    <span class="sr-only">(current)</span>
                {% endif %}
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{path('questionnaires_browse')}}">Questionnaires</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{% if app.session.get('username')!=null %} {{path('users_signout')}} {% else %} {{path('users_login')}} {% endif %}">{% if app.session.get('username')!=null %} Logout {% else %} Login {% endif %}</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Page Content -->
  <div class="container">
  {% block usermenu %}{% endblock %}
    {% block body %}
    <!-- Heading Row -->
    <div class="row align-items-center my-5">
      <div class="col-lg-7">
        <img class="img-fluid rounded mb-4 mb-lg-0" src="{{ asset('images/questionnaire-illustration.svg') }}" alt="Illustration of a questionnaire with completed responses">
      </div>
      <!-- /.col-lg-8 -->
      <div class="col-lg-5">
        <h1 class="font-weight-light">Good questions lead to useful answers</h1>
        <p>Create questionnaires, organize questions into steps, and invite people to share their responses. Browse active questionnaires or sign in to manage your own.</p>
        <a class="btn btn-primary" href="{{ path('questionnaires_browse') }}">Browse questionnaires</a>
      </div>
      <!-- /.col-md-4 -->
    </div>
    <!-- /.row -->

    <!-- Call to Action Well -->
    <div class="card text-white bg-secondary my-5 py-4 text-center">
      <div class="card-body">
        <p class="text-white m-0">Have a few questions to ask? Build a questionnaire and make it available for people to complete.</p>
      </div>
    </div>

    <!-- Content Row -->
    <div class="row">
      <div class="col-md-4 mb-5">
        <div class="card h-100">
          <div class="card-body">
            <h2 class="card-title">Create</h2>
            <p class="card-text">Set up a questionnaire, arrange it into steps, and add questions and answer options.</p>
          </div>
          <div class="card-footer">
            <a href="{{ path('users_login') }}" class="btn btn-primary btn-sm">Sign in</a>
          </div>
        </div>
      </div>
      <!-- /.col-md-4 -->
      <div class="col-md-4 mb-5">
        <div class="card h-100">
          <div class="card-body">
            <h2 class="card-title">Participate</h2>
            <p class="card-text">Explore active questionnaires and share your perspective by answering their questions.</p>
          </div>
          <div class="card-footer">
            <a href="{{ path('questionnaires_browse') }}" class="btn btn-primary btn-sm">Browse</a>
          </div>
        </div>
      </div>
      <!-- /.col-md-4 -->
      <div class="col-md-4 mb-5">
        <div class="card h-100">
          <div class="card-body">
            <h2 class="card-title">Review responses</h2>
            <p class="card-text">Keep questionnaire responses together and review the answers submitted by participants.</p>
          </div>
          <div class="card-footer">
            <a href="{{ path('users_login') }}" class="btn btn-primary btn-sm">Get started</a>
          </div>
        </div>
      </div>
      <!-- /.col-md-4 -->

    </div>
    <!-- /.row -->
{% endblock %}
  </div>
  <!-- /.container -->

  <!-- Footer -->
  <footer class="py-5 bg-dark">
    <div class="container">
      <p class="m-0 text-center text-white">Questionnaire &middot; Exercise project, 2020</p>
    </div>
    <!-- /.container -->
  </footer>

  <!-- Bootstrap core JavaScript -->
  <script src="{{asset('vendor/jquery/jquery.min.js')}}"></script>
  <script src="{{asset('vendor/bootstrap/js/bootstrap.bundle.min.js')}}"></script>

</body>

</html>
